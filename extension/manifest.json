{
  "manifest_version": 3,
  "name": "Mind Boss Clipper",
  "description": "Save the current page, selected text, and a quick note to your private Mind Boss inbox.",
  "version": "0.2.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": ["https://mindboss.st-dba.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Save to Mind Boss",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+M", "mac": "Command+Shift+M" },
      "description": "Open the Mind Boss clipper"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
